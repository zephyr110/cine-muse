{
  "name": "cine-studio",
  "version": "0.1.0",
  "private": true,
  "description": "从剧本到成片的一站式 AI 视频生产工作台（桌面客户端）",
  "author": "Cine Studio Team",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:electron": "tsc -p electron/tsconfig.json",
    "dev:server": "node server/index.js",
    "dev:desktop": "pnpm build:electron && CINE_DEV_URL=http://localhost:3000 electron .",
    "build:desktop": "CINE_RELATIVE_ASSETS=1 next build && pnpm build:electron && electron-builder",
    "build:desktop:dir": "CINE_RELATIVE_ASSETS=1 next build && pnpm build:electron && electron-builder --dir",
    "desktop:pack": "pnpm build:desktop:dir"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^9.2.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "immer": "^11.1.18",
    "lucide-react": "^1.34.0",
    "multer": "^2.3.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0"
  },
  "packageManager": "pnpm@11.14.0"
}
